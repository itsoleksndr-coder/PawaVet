{
  "name": "pawfect-saas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "npm run lint && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.js && esbuild server/api.ts --bundle --platform=node --format=esm --packages=external --outfile=build/api.js",
    "start": "node build/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:provision": "node --import tsx scripts/provision.ts",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm run test:serverless && npm run test:billing && npm run test:e2e",
    "test:billing": "node --import tsx --test tests/billing.test.ts",
    "test:serverless": "node --test tests/serverless.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.6.2",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}

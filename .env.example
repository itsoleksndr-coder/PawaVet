# Production requires a durable PostgreSQL database. Never expose this in VITE_*.
DATABASE_URL=
# Canonical frontend origin for mutation origin checks.
APP_URL=http://localhost:3000
# Local development / isolated testing only; do not use as production storage.
# Leave DATABASE_URL empty to use this explicit local option.
LOCAL_DATABASE_PATH=.local-db
# Used only by npm run db:provision; remove these after initial provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
CLINIC_NAME=
# Railway sets PORT automatically. APP_COMMIT is optional build metadata.
APP_COMMIT=

# Required before deploying MFA. 32 securely generated bytes, base64 encoded.
# Back up securely. Losing this value prevents enrolled users from signing in.
MFA_ENCRYPTION_KEY=

# AI support agents (server-only; never prefix with VITE_). The four specialists
# are appointments, onboarding, billing and technical. Leave empty until the
# provider account and synthetic-account verification are approved.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Appointment reminders: keep worker disabled until provider delivery,
# opt-in consent and sender setup are tested.
REMINDERS_WORKER_ENABLED=false
REMINDER_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Telemedicine provider room base URL. Keep empty until the provider account,
# consent wording and webhook/record-retention policy are approved.
TELEMED_ROOM_BASE_URL=

# Clinic subscriptions: keep test until hosted verification and business setup pass.
STRIPE_BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_ENFORCED=false
# Live checkout requires all three true, HTTPS APP_URL and the public contact URLs below.
BILLING_LAUNCH_APPROVED=false
BILLING_TAX_REVIEWED=false
TERMS_URL=
PRIVACY_URL=
SUPPORT_EMAIL=

# Password recovery and email reminders: verified Resend domain; keep server-side only.
RESEND_API_KEY=
PASSWORD_RESET_FROM=
